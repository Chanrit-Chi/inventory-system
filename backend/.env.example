APP_NAME="Omnichannel Inventory System"
APP_ENV=local
APP_KEY=base64:your-32-character-app-key-here=
APP_DEBUG=true
APP_TIMEZONE=UTC
APP_URL=http://localhost:8000

SANCTUM_STATEFUL_DOMAINS=localhost,localhost:3000,127.0.0.1,127.0.0.1:8000
SANCTUM_EXPIRATION=43200

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Database Configuration (Default: SQLite for local dev & testing)
DB_CONNECTION=sqlite
DB_DATABASE=database/database.sqlite
DB_FOREIGN_KEYS=true

# PostgreSQL (Neon) Production Connection
# DB_CONNECTION=pgsql
# DB_HOST=ep-example-pooler.us-east-2.aws.neon.tech
# DB_PORT=5432
# DB_DATABASE=neondb
# DB_USERNAME=neondb_owner
# DB_PASSWORD=your-neon-password
# DB_SSLMODE=require
# DATABASE_URL="postgresql://neondb_owner:your-neon-password@ep-example-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require"

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=public
QUEUE_CONNECTION=sync

CACHE_STORE=file
CACHE_PREFIX=

# Cloudflare R2 Object Storage
CLOUDFLARE_R2_ACCESS_KEY_ID=
CLOUDFLARE_R2_SECRET_ACCESS_KEY=
CLOUDFLARE_R2_BUCKET=inventory-assets
CLOUDFLARE_R2_ENDPOINT=https://your-account-id.r2.cloudflarestorage.com
CLOUDFLARE_R2_URL=https://cdn.store.com
R2_PUBLIC_URL=https://cdn.store.com

# Client URLs
FRONTEND_WEB_URL=http://localhost:5173
FRONTEND_MOBILE_URL=http://localhost:8081
