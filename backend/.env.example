APP_NAME="Omnichannel Inventory System"
APP_ENV=local
APP_KEY=base64:your-32-character-app-key-here=
APP_DEBUG=true
APP_TIMEZONE=UTC
APP_URL=http://localhost:8000

SANCTUM_STATEFUL_DOMAINS=localhost,localhost:3000,127.0.0.1,127.0.0.1:8000
SANCTUM_EXPIRATION=43200

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Database Configuration (Default: SQLite for local dev & testing)
DB_CONNECTION=sqlite
DB_DATABASE=database/database.sqlite
DB_FOREIGN_KEYS=true

# Supabase PostgreSQL Production Connection
# DB_CONNECTION=pgsql
# DB_HOST=aws-0-ap-southeast-1.pooler.supabase.com
# DB_PORT=6543
# DB_DATABASE=postgres
# DB_USERNAME=postgres.your-project-ref
# DB_PASSWORD=your-supabase-db-password
# DB_SSLMODE=require
# Or complete DATABASE_URL string:
# DATABASE_URL="postgresql://postgres.your-project-ref:your-supabase-db-password@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres?sslmode=require"

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=public
QUEUE_CONNECTION=sync

CACHE_STORE=file
CACHE_PREFIX=

# Supabase S3-Compatible Storage
SUPABASE_STORAGE_ACCESS_KEY_ID=
SUPABASE_STORAGE_SECRET_ACCESS_KEY=
SUPABASE_STORAGE_BUCKET=inventory-assets
SUPABASE_STORAGE_REGION=us-east-1
SUPABASE_STORAGE_ENDPOINT=https://your-project-ref.supabase.co/storage/v1/s3
SUPABASE_STORAGE_PUBLIC_URL=https://your-project-ref.supabase.co/storage/v1/object/public/inventory-assets

# Cloudflare R2 Object Storage (Alternative)
CLOUDFLARE_R2_ACCESS_KEY_ID=
CLOUDFLARE_R2_SECRET_ACCESS_KEY=
CLOUDFLARE_R2_BUCKET=inventory-assets
CLOUDFLARE_R2_ENDPOINT=https://your-account-id.r2.cloudflarestorage.com
CLOUDFLARE_R2_URL=https://cdn.store.com
R2_PUBLIC_URL=https://cdn.store.com

# Client URLs (CORS)
FRONTEND_WEB_URL=http://localhost:5173
FRONTEND_MOBILE_URL=http://localhost:8081
