# ─── OS & Editors ───────────────────────────────────────────────
.DS_Store
Thumbs.db
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
.idea/
.vscode/

# ─── Backend (Laravel) ──────────────────────────────────────────
backend/vendor/
backend/.env
backend/.env.backup
backend/.env.production
backend/.phpunit.result.cache
backend/storage/*.key
backend/storage/framework/cache/*
backend/storage/framework/sessions/*
backend/storage/framework/views/*
backend/storage/logs/*
!backend/storage/framework/cache/.gitignore
!backend/storage/framework/sessions/.gitignore
!backend/storage/framework/views/.gitignore
!backend/storage/logs/.gitignore

# ─── Frontend (Web - Vite) ──────────────────────────────────────
frontend/web/node_modules/
frontend/web/dist/
frontend/web/dist-ssr/
frontend/web/*.local
frontend/web/.env

# ─── Frontend (Mobile) ──────────────────────────────────────────
frontend/mobile/node_modules/
frontend/mobile/.env

# ─── Test artifacts ─────────────────────────────────────────────
.pytest_cache/
tests/__pycache__/

# ─── Agents / AI tooling ────────────────────────────────────────
.agents/

# ─── Logs ───────────────────────────────────────────────────────
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
